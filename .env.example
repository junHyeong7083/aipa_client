# AIPA 클라이언트 환경변수 — 이 파일을 .env 로 복사 후 값 채우기
# (.env 는 git 미추적 + pubspec.yaml 에서 asset 으로 번들링됨)

# AIPA Engine 서버 주소 (스킴 포함, 끝에 / 없이)
#  - Android 에뮬레이터에서 로컬 서버 접속: http://10.0.2.2:8080
#  - 실기기 + 로컬 서버: http://<PC의 LAN IP>:8080
#  - 운영: https://<VM_IP를-하이픈으로>.nip.io
API_BASE_URL=http://10.0.2.2:8080

# 서버 .env 의 API_BEARER_TOKEN 과 동일한 값 (쓰기 API 보호용 공유 토큰)
API_BEARER_TOKEN=

# 카카오 개발자 콘솔 네이티브 앱 키
# 변경 시 android/app/src/main/AndroidManifest.xml 의
# android:scheme="kakao<앱키>" 도 함께 수정해야 함
KAKAO_NATIVE_APP_KEY=
